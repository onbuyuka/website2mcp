{
  "name": "site2mcp",
  "version": "1.0.0",
  "description": "Turn any website - live URL, build output, or source folder - into a read-only MCP server for AI assistants.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "website",
    "docs",
    "crawler",
    "search",
    "vite-plugin",
    "astro-integration"
  ],
  "license": "MIT",
  "author": "Onat Buyukakkus",
  "repository": {
    "type": "git",
    "url": "https://github.com/onbuyuka/site2mcp.git"
  },
  "homepage": "https://github.com/onbuyuka/site2mcp#readme",
  "bugs": {
    "url": "https://github.com/onbuyuka/site2mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "site2mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.14",
    "minisearch": "^7.2.0",
    "playwright-core": "^1.64.1",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/turndown": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
